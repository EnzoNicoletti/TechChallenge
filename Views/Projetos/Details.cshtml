@model TechChallenge.Models.Projeto

@{
    ViewData["Title"] = "Detalhes do Projeto";
}

<div class="form-page">

    <div class="form-page-header">
        <h1 class="form-page-title">Detalhes do Projeto</h1>
        <p class="form-page-description">
            Consulte todas as informações relacionadas ao projeto, sua equipe,
            categoria, professor responsável e período de execução.
        </p>
    </div>

    <div class="details-card">

        <h4 class="details-title">Projeto</h4>

        <dl class="details-list">

            <dt>@Html.DisplayNameFor(model => model.Nome)</dt>
            <dd>@Html.DisplayFor(model => model.Nome)</dd>

            <dt>@Html.DisplayNameFor(model => model.Descricao)</dt>
            <dd>@Html.DisplayFor(model => model.Descricao)</dd>

            <dt>@Html.DisplayNameFor(model => model.DataInicio)</dt>
            <dd>@Html.DisplayFor(model => model.DataInicio)</dd>

            <dt>@Html.DisplayNameFor(model => model.DataFim)</dt>
            <dd>@Html.DisplayFor(model => model.DataFim)</dd>

            <dt>@Html.DisplayNameFor(model => model.Pontuacao)</dt>
            <dd>@Html.DisplayFor(model => model.Pontuacao)</dd>

            <dt>@Html.DisplayNameFor(model => model.Professor)</dt>
            <dd>@Html.DisplayFor(model => model.Professor.Email)</dd>

            <dt>@Html.DisplayNameFor(model => model.Categoria)</dt>
            <dd>@Html.DisplayFor(model => model.Categoria.Nome)</dd>

            <dt>@Html.DisplayNameFor(model => model.Equipe)</dt>
            <dd>@Html.DisplayFor(model => model.Equipe.Nome)</dd>

        </dl>

        <div class="details-actions">

            <a asp-action="Edit"
               asp-route-id="@Model?.Id"
               class="btn btn-primary">
                <i class="bi bi-pencil-fill"></i>
                Editar
            </a>

            <a asp-action="Index"
               class="details-back-link">
                Voltar para a lista
            </a>

        </div>

    </div>

</div>