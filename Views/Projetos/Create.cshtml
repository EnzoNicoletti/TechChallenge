@model TechChallenge.Models.Projeto

@{
    ViewData["Title"] = "Novo Projeto";
}

<div class="create-page">

    <div class="create-header">
        <h1 class="create-title">Novo Projeto</h1>
        <p class="create-subtitle">
            Cadastre um novo projeto estudantil e defina seus responsáveis,
            categoria, equipe e período de desenvolvimento.
        </p>
    </div>

    <div class="create-form-card">

        <form asp-action="Create">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger create-validation"></div>

            <div class="create-form-group">
                <label asp-for="Nome"></label>
                <input asp-for="Nome" class="form-control" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>

            <div class="create-form-group">
                <label asp-for="Descricao"></label>
                <input asp-for="Descricao" class="form-control" />
                <span asp-validation-for="Descricao" class="text-danger"></span>
            </div>

            <div class="create-form-group">
                <label asp-for="DataInicio"></label>
                <input asp-for="DataInicio" class="form-control" />
                <span asp-validation-for="DataInicio" class="text-danger"></span>
            </div>

            <div class="create-form-group">
                <label asp-for="DataFim"></label>
                <input asp-for="DataFim" class="form-control" />
                <span asp-validation-for="DataFim" class="text-danger"></span>
            </div>

            <div class="create-form-group">
                <label asp-for="Pontuacao"></label>
                <input asp-for="Pontuacao" class="form-control" />
                <span asp-validation-for="Pontuacao" class="text-danger"></span>
            </div>

            <div class="create-form-group">
                <label asp-for="ProfessorId"></label>
                <select asp-for="ProfessorId"
                        class="form-control"
                        asp-items="ViewBag.ProfessorId">
                </select>
                <span asp-validation-for="ProfessorId" class="text-danger"></span>
            </div>

            <div class="create-form-group">
                <label asp-for="CategoriaId"></label>
                <select asp-for="CategoriaId"
                        class="form-control"
                        asp-items="ViewBag.CategoriaId">
                </select>
                <span asp-validation-for="CategoriaId" class="text-danger"></span>
            </div>

            <div class="create-form-group">
                <label asp-for="EquipeId"></label>
                <select asp-for="EquipeId"
                        class="form-control"
                        asp-items="ViewBag.EquipeId">
                </select>
                <span asp-validation-for="EquipeId" class="text-danger"></span>
            </div>

            <div class="create-form-actions">

                <a asp-action="Index" class="create-back">
                    <i class="bi bi-arrow-left"></i>
                    Voltar para projetos
                </a>

                <button type="submit" class="btn btn-primary create-submit">
                    <i class="bi bi-kanban-fill"></i>
                    Criar projeto
                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}