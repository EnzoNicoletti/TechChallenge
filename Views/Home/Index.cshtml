@{
ViewData["Title"] = "Início";
}

<main class="home">


<!-- HERO -->
<section class="hero">

    <div class="hero-content">

        <span class="hero-badge">
            Plataforma de gestão estudantil
        </span>

        <h1>
            Transforme ideias em
            <span>projetos.</span>
        </h1>

        <p>
            Organize, acompanhe e desenvolva seus projetos
            estudantis em um só lugar.
        </p>

        <div class="hero-buttons">
            <a href="/Projetos" class="btn-primary">
                Começar agora
            </a>

            <a href="Tech/About" class="btn-secondary">
                Conhecer a plataforma
            </a>
        </div>

    </div>

    <!-- CARD VISUAL -->
    <div class="hero-visual">

        <div class="project-card">

            <div class="project-header">
                <div>
                    <span class="project-label">PROJETO ATUAL</span>
                    <h3>Tech Challenge</h3>
                </div>

                <span class="project-icon">↗</span>
            </div>

            <div class="progress-section">

                <div class="progress-info">
                    <span>Progresso</span>
                    <strong>80%</strong>
                </div>

                <div class="progress-bar">
                    <div class="progress-value"></div>
                </div>

            </div>

            <div class="tasks">

                <div class="task completed">
                    <span>✓</span>
                    <p>Planejamento</p>
                </div>

                <div class="task completed">
                    <span>✓</span>
                    <p>Desenvolvimento</p>
                </div>

                <div class="task">
                    <span>○</span>
                    <p>Apresentação</p>
                </div>

            </div>

        </div>

        <div class="floating-card floating-card-one">
            <strong>+12</strong>
            <span>Tarefas concluídas</span>
        </div>

        <div class="floating-card floating-card-two">
            <strong>4</strong>
            <span>Integrantes</span>
        </div>

    </div>

</section>


<!-- RECURSOS -->
<section class="features" id="recursos">

    <div class="section-heading">

        <span>POR QUE USAR?</span>

        <h2>
            Tudo que seu projeto precisa.
        </h2>

        <p>
            Uma plataforma pensada para tornar o desenvolvimento
            de projetos estudantis mais simples e organizado.
        </p>

    </div>


    <div class="feature-grid">

        <article class="feature-card">

            <div class="feature-icon">
                📋
            </div>

            <h3>Organização</h3>

            <p>
                Centralize tarefas, informações e etapas
                do seu projeto em um único lugar.
            </p>

        </article>


        <article class="feature-card">

            <div class="feature-icon">
                👥
            </div>

            <h3>Trabalho em equipe</h3>

            <p>
                Facilite a colaboração entre os integrantes
                e mantenha todos alinhados.
            </p>

        </article>


        <article class="feature-card">

            <div class="feature-icon">
                📈
            </div>

            <h3>Acompanhe o progresso</h3>

            <p>
                Visualize o andamento do projeto e saiba
                exatamente o que ainda precisa ser feito.
            </p>

        </article>

    </div>

</section>


<!-- CTA -->
<section class="cta">

    <div>

        <span>PRONTO PARA COMEÇAR?</span>

        <h2>
            Tire seu projeto do papel.
        </h2>

        <p>
            Organize suas ideias, reúna sua equipe
            e acompanhe cada etapa do desenvolvimento.
        </p>

        <a href="/Projetos" class="btn-primary">
            Começar um projeto
        </a>

    </div>

</section>
```

</main>
