@using Microsoft.EntityFrameworkCore.Metadata.Internal
@model Microsoft.AspNetCore.Identity.IdentityUser

@{
    var rolesDisponiveis = ViewBag.rolesDisponiveis;
    ViewData["Title"] = "Alterar Perfil";
}

<div class="edit-page">

    <div class="edit-card">

        <div class="edit-header">
            <h1>Alterar Perfil</h1>

            <p>
                Altere o perfil de acesso deste usuário.
            </p>
        </div>

        <hr />

        <form method="post" action="TrocarPerfil">

            <input type="hidden" name="idUser" value="@Model.Id" />

            <div class="form-group">
                <label class="control-label">
                    Usuário
                </label>

                <input type="text"
                       class="form-control"
                       value="@Model.Email"
                       readonly />
            </div>

            <div class="form-group">
                <label for="role" class="control-label">
                    Perfil
                </label>

                <select name="role"
                        id="role"
                        class="form-control">

                    @foreach (var role in rolesDisponiveis)
                    {
                        <option value="@role">
                            @role
                        </option>
                    }

                </select>
            </div>

            <div class="edit-actions">

                <input type="submit"
                       value="Salvar Alteração"
                       class="btn btn-primary" />

                <a asp-action="Usuarios"
                   class="btn btn-outline-secondary">
                    Voltar
                </a>

            </div>

        </form>

    </div>

</div>