@model TechChallenge.Professor

@{
    ViewData["Title"] = "Novo Professor";
}

<div class="create-page">

    <div class="create-header">
        <h1 class="create-title">Novo Professor</h1>

        <p class="create-subtitle">
            Cadastre um professor para acompanhar, orientar e participar
            do desenvolvimento dos projetos estudantis.
        </p>
    </div>


    <div class="create-form-card">

        <form asp-action="Create">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger create-validation"></div>


            <div class="create-form-group">
                <label asp-for="Nome"></label>

                <input asp-for="Nome"
                       class="form-control" />

                <span asp-validation-for="Nome"
                      class="text-danger"></span>
            </div>


            <div class="create-form-group">
                <label asp-for="Email"></label>

                <input asp-for="Email"
                       class="form-control" />

                <span asp-validation-for="Email"
                      class="text-danger"></span>
            </div>


            <div class="create-form-group">
                <label asp-for="Especialidade"></label>

                <input asp-for="Especialidade"
                       class="form-control" />

                <span asp-validation-for="Especialidade"
                      class="text-danger"></span>
            </div>


            <div class="create-form-group">
                <label asp-for="DataContratacao"></label>

                <input asp-for="DataContratacao"
                       class="form-control" />

                <span asp-validation-for="DataContratacao"
                      class="text-danger"></span>
            </div>


            <div class="create-form-check">

                <input class="form-check-input"
                       asp-for="Ativo" />

                <label asp-for="Ativo"></label>

            </div>


            <div class="create-form-actions">

                <a asp-action="Index"
                   class="create-back">

                    <i class="bi bi-arrow-left"></i>
                    Voltar para professores

                </a>


                <button type="submit"
                        class="btn btn-primary create-submit">

                    <i class="bi bi-person-workspace"></i>
                    Criar professor

                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}