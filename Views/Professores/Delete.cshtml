@model TechChallenge.Professor

@{
    ViewData["Title"] = "Excluir Professor";
}

<div class="delete-page">

    <div class="delete-card">

        <div class="delete-header">

            <div class="delete-icon">
                <i class="bi bi-trash-fill"></i>
            </div>

            <h1 class="delete-title">
                Excluir Professor
            </h1>

            <p class="delete-warning">
                Tem certeza de que deseja excluir este professor?
                Esta ação não poderá ser desfeita.
            </p>

        </div>


        <div class="delete-info">

            <div class="delete-info-row">
                <span>Nome</span>
                <strong>@Html.DisplayFor(model => model.Nome)</strong>
            </div>

            <div class="delete-info-row">
                <span>Email</span>
                <strong>@Html.DisplayFor(model => model.Email)</strong>
            </div>

            <div class="delete-info-row">
                <span>Especialidade</span>
                <strong>@Html.DisplayFor(model => model.Especialidade)</strong>
            </div>

            <div class="delete-info-row">
                <span>Data de contratação</span>
                <strong>@Html.DisplayFor(model => model.DataContratacao)</strong>
            </div>

            <div class="delete-info-row">
                <span>Status</span>
                <strong>
                    @(Model.Ativo ? "Ativo" : "Inativo")
                </strong>
            </div>

        </div>


        <form asp-action="Delete" class="delete-actions">

            <input type="hidden" asp-for="Id" />

            <a asp-action="Index"
               class="delete-cancel">

                <i class="bi bi-arrow-left"></i>
                Cancelar

            </a>

            <button type="submit"
                    class="delete-confirm">

                <i class="bi bi-trash-fill"></i>
                Excluir professor

            </button>

        </form>

    </div>

</div>