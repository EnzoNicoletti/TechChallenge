@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

@if (SignInManager.IsSignedIn(User))
{
    <span>Ola, @User.Identity?.Name!</span>
    <form asp-action="Logout" method="post">
        @Html.AntiForgeryToken()
        <button type="submit">Sair</button>
    </form>
}
else
{
    <a asp-controller="Account" asp-action="Register" class="btn btn-outline-success mx-1">
        <i class="bi bi-person-plus-fill"></i> Cadastro </a>
    <a asp-controller="Account" asp-action="Login" class="btn-outline-primary btn mx-1" >
        <i class="bi bi-box-arrow-in-right"></i> Entrar</a>
}