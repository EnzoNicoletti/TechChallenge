@model TechChallenge.Aluno

@{
    ViewData["Title"] = "Editar Aluno";
}

<div class="create-page">

    <div class="create-header">

        <h1 class="create-title">
            Editar Aluno
        </h1>

        <p class="create-subtitle">
            Atualize as informações do aluno para manter seus dados
            e participação nos projetos estudantis sempre atualizados.
        </p>

    </div>


    <div class="create-form-card">

        <form asp-action="Edit">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger create-validation">
            </div>

            <input type="hidden" asp-for="Id" />


            <div class="create-form-group">

                <label asp-for="Nome"></label>

                <input asp-for="Nome"
                       class="form-control" />

                <span asp-validation-for="Nome"
                      class="text-danger">
                </span>

            </div>


            <div class="create-form-group">

                <label asp-for="Email"></label>

                <input asp-for="Email"
                       class="form-control" />

                <span asp-validation-for="Email"
                      class="text-danger">
                </span>

            </div>


            <div class="create-form-group">

                <label asp-for="Telefone"></label>

                <input asp-for="Telefone"
                       class="form-control" />

                <span asp-validation-for="Telefone"
                      class="text-danger">
                </span>

            </div>


            <div class="create-form-group">

                <label asp-for="DataNascimento"></label>

                <input asp-for="DataNascimento"
                       class="form-control" />

                <span asp-validation-for="DataNascimento"
                      class="text-danger">
                </span>

            </div>


            <div class="create-form-group">

                <label asp-for="DataCadastro"></label>

                <input asp-for="DataCadastro"
                       class="form-control" />

                <span asp-validation-for="DataCadastro"
                      class="text-danger">
                </span>

            </div>


            <div class="create-form-check">

                <input class="form-check-input"
                       asp-for="Ativo" />

                <label asp-for="Ativo"></label>

            </div>


            <div class="create-form-actions">

                <a asp-action="Index"
                   class="create-back">

                    <i class="bi bi-arrow-left"></i>
                    Voltar para alunos

                </a>


                <button type="submit"
                        class="btn btn-primary create-submit">

                    <i class="bi bi-check-lg"></i>
                    Salvar alterações

                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}