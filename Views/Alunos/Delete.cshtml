@model TechChallenge.Aluno

@{
    ViewData["Title"] = "Excluir Aluno";
}

<div class="delete-page">

    <div class="delete-card">

        <div class="delete-header">

            <div class="delete-icon">
                <i class="bi bi-trash-fill"></i>
            </div>

            <h1 class="delete-title">
                Excluir Aluno
            </h1>

            <p class="delete-warning">
                Tem certeza de que deseja excluir este aluno?
                Esta ação não poderá ser desfeita.
            </p>

        </div>


        <div class="delete-info">

            <div class="delete-info-row">
                <span>Nome</span>
                <strong>@Html.DisplayFor(model => model.Nome)</strong>
            </div>

            <div class="delete-info-row">
                <span>Email</span>
                <strong>@Html.DisplayFor(model => model.Email)</strong>
            </div>

            <div class="delete-info-row">
                <span>Telefone</span>
                <strong>@Html.DisplayFor(model => model.Telefone)</strong>
            </div>

            <div class="delete-info-row">
                <span>Data de nascimento</span>
                <strong>@Html.DisplayFor(model => model.DataNascimento)</strong>
            </div>

            <div class="delete-info-row">
                <span>Data de cadastro</span>
                <strong>@Html.DisplayFor(model => model.DataCadastro)</strong>
            </div>

            <div class="delete-info-row">
                <span>Status</span>
                <strong>
                    @(Model.Ativo ? "Ativo" : "Inativo")
                </strong>
            </div>

        </div>


        <form asp-action="Delete" class="delete-actions">

            <input type="hidden" asp-for="Id" />

            <a asp-action="Index"
               class="delete-cancel">

                <i class="bi bi-arrow-left"></i>
                Cancelar

            </a>

            <button type="submit"
                    class="delete-confirm">

                <i class="bi bi-trash-fill"></i>
                Excluir aluno

            </button>

        </form>

    </div>

</div>