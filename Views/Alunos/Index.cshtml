@model IEnumerable<TechChallenge.Aluno>

@{
    ViewData["Title"] = "Alunos";
}

<div class="table-page">

    <!-- Cabeçalho -->
    <div class="table-page-header">

        <div>
            <h1 class="table-page-title">
                Alunos
            </h1>

            <p class="table-page-description">
                Consulte e gerencie os alunos cadastrados na plataforma,
                acompanhando suas informações e participação nos projetos estudantis.
            </p>
        </div>

        <a asp-action="Create" class="table-create-button">
            <i class="bi bi-plus-lg"></i>
            Novo Aluno
        </a>

        <form asp-action="Index" method="get">
            <input type="text" name="searchString" value="@ViewBag.CurrentFilter" class="form-control" placeholder="Procure por nome ou email"/>
            <button type="submit" class="btn btn-primary">Procurar</button>
            <a asp-action="Index" class="btn btn-secondary">Limpar</a>
        </form>

    </div>


    <!-- Tabela -->
    <div class="table-container">

        <div class="table-responsive">

            <table class="table tech-table table-striped">

                <thead>
                    <tr>

                        <th>
                            @Html.DisplayNameFor(model => model.Nome)
                        </th>

                        <th>
                            @Html.DisplayNameFor(model => model.Email)
                        </th>

                        <th>
                            @Html.DisplayNameFor(model => model.Telefone)
                        </th>

                        <th>
                            @Html.DisplayNameFor(model => model.DataNascimento)
                        </th>

                        <th>
                            @Html.DisplayNameFor(model => model.DataCadastro)
                        </th>

                        <th>
                            @Html.DisplayNameFor(model => model.Ativo)
                        </th>

                        <th class="actions-column">
                            Ações
                        </th>

                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <!-- NOME -->
                            <td class="fw-semibold">
                                @Html.DisplayFor(modelItem => item.Nome)
                            </td>


                            <!-- EMAIL -->
                            <td>
                                @Html.DisplayFor(modelItem => item.Email)
                            </td>


                            <!-- TELEFONE -->
                            <td>
                                @Html.DisplayFor(modelItem => item.Telefone)
                            </td>


                            <!-- DATA DE NASCIMENTO -->
                            <td>
                                @Html.DisplayFor(modelItem => item.DataNascimento)
                            </td>


                            <!-- DATA DE CADASTRO -->
                            <td>
                                @Html.DisplayFor(modelItem => item.DataCadastro)
                            </td>


                            <!-- STATUS -->
                            <td>

                                @if (item.Ativo)
                                {
                                    <span class="badge category-active">
                                        <i class="bi bi-check-circle-fill"></i>
                                        Ativo
                                    </span>
                                }
                                else
                                {
                                    <span class="badge category-inactive">
                                        <i class="bi bi-dash-circle-fill"></i>
                                        Inativo
                                    </span>
                                }

                            </td>


                            <!-- AÇÕES -->
                            <td>

                                <div class="table-actions">

                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="table-action edit-action"
                                       title="Editar">

                                        <i class="bi bi-pencil-fill"></i>

                                    </a>


                                    <a asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="table-action details-action"
                                       title="Detalhes">

                                        <i class="bi bi-eye-fill"></i>

                                    </a>


                                    <a asp-action="Delete"
                                       asp-route-id="@item.Id"
                                       class="table-action delete-action"
                                       title="Excluir">

                                        <i class="bi bi-trash-fill"></i>

                                    </a>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>