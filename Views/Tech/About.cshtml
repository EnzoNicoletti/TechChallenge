@{
    ViewData["Title"] = "Sobre";
}

<main class="about-page">

    <!-- HERO -->
<!-- HERO SOBRE -->

<section class="about-intro">

    <div class="about-intro-line"></div>

    <span class="about-intro-label">
        SOBRE O TECHCHALLENGE
    </span>

    <h1>
        Onde ideias encontram
        <span>desafios.</span>
    </h1>

    <p>
        Uma plataforma criada para transformar o aprendizado
        em experiências práticas, colaborativas e desafiadoras.
    </p>

    <div class="about-intro-bottom">

        <div class="intro-number">
            <strong>01</strong>
            <span>Escolha um desafio</span>
        </div>

        <div class="intro-number">
            <strong>02</strong>
            <span>Crie uma solução</span>
        </div>

        <div class="intro-number">
            <strong>03</strong>
            <span>Evolua com sua equipe</span>
        </div>

    </div>

</section>


    <!-- COMO FUNCIONA -->
    <section class="how-section" id="como-funciona">

        <div class="about-section-title">

            <span>COMO FUNCIONA</span>

            <h2>
                Do desafio ao projeto.
            </h2>

            <p>
                O TechChallenge transforma o aprendizado em uma jornada
                prática, colaborativa e orientada a resultados.
            </p>

        </div>


        <div class="steps">

            <div class="step">

                <div class="step-number">
                    01
                </div>

                <h3>Escolha um desafio</h3>

                <p>
                    Explore desafios de diferentes áreas e encontre
                    aquele que mais combina com seus interesses.
                </p>

            </div>


            <div class="step">

                <div class="step-number">
                    02
                </div>

                <h3>Forme sua equipe</h3>

                <p>
                    Reúna colegas e compartilhe conhecimentos para
                    construir uma solução em conjunto.
                </p>

            </div>


            <div class="step">

                <div class="step-number">
                    03
                </div>

                <h3>Desenvolva o projeto</h3>

                <p>
                    Transforme sua ideia em uma solução e acompanhe
                    cada etapa do desenvolvimento.
                </p>

            </div>


            <div class="step">

                <div class="step-number">
                    04
                </div>

                <h3>Evolua juntos</h3>

                <p>
                    Aprenda com os desafios, acompanhe seus resultados
                    e continue desenvolvendo novas habilidades.
                </p>

            </div>

        </div>

    </section>


    <!-- FUNCIONALIDADES -->
    <section class="features-about">

        <div class="about-section-title">

            <span>O QUE VOCÊ ENCONTRA</span>

            <h2>
                Tudo para transformar ideias em resultados.
            </h2>

        </div>


        <div class="about-feature-grid">

            <article class="about-feature-card">

                <div class="about-feature-icon">
                    🏆
                </div>

                <h3>Desafios</h3>

                <p>
                    Descubra propostas de diferentes áreas e escolha
                    novos problemas para solucionar.
                </p>

            </article>


            <article class="about-feature-card">

                <div class="about-feature-icon">
                    👥
                </div>

                <h3>Equipes</h3>

                <p>
                    Trabalhe colaborativamente e transforme diferentes
                    ideias em uma única solução.
                </p>

            </article>


            <article class="about-feature-card">

                <div class="about-feature-icon">
                    📊
                </div>

                <h3>Projetos</h3>

                <p>
                    Organize e acompanhe os projetos desenvolvidos
                    durante sua jornada.
                </p>

            </article>


            <article class="about-feature-card">

                <div class="about-feature-icon">
                    🎓
                </div>

                <h3>Alunos</h3>

                <p>
                    Desenvolva habilidades enquanto participa de
                    experiências práticas de aprendizagem.
                </p>

            </article>


            <article class="about-feature-card">

                <div class="about-feature-icon">
                    👨‍🏫
                </div>

                <h3>Professores</h3>

                <p>
                    Acompanhe e incentive projetos que aproximam
                    teoria e prática.
                </p>

            </article>


            <article class="about-feature-card">

                <div class="about-feature-icon">
                    🥇
                </div>

                <h3>Pontuação</h3>

                <p>
                    Transforme sua participação em desafios em
                    conquistas e evolução.
                </p>

            </article>

        </div>

    </section>


    <!-- DIFERENCIAL -->
    <section class="about-highlight">

        <div class="highlight-content">

            <span>
                APRENDIZADO NA PRÁTICA
            </span>

            <h2>
                Aprender é mais interessante
                quando você coloca a ideia em prática.
            </h2>

            <p>
                No TechChallenge, cada desafio é uma oportunidade
                para experimentar, colaborar, criar e encontrar
                soluções para problemas reais.
            </p>

        </div>

        <div class="highlight-stats">

            <div>
                <strong>01</strong>
                <span>Desafio</span>
            </div>

            <div>
                <strong>+</strong>
                <span>Ideias</span>
            </div>

            <div>
                <strong>∞</strong>
                <span>Possibilidades</span>
            </div>

        </div>

    </section>


    <!-- CTA FINAL -->
    <section class="about-cta">

        <span>
            SEU PRÓXIMO DESAFIO COMEÇA AQUI
        </span>

        <h2>
            Pronto para transformar uma ideia em projeto?
        </h2>

        <p>
            Explore os desafios disponíveis e descubra onde
            sua próxima ideia pode chegar.
        </p>

        <a asp-controller="Home"
           asp-action="Dashboard"
           class="about-primary">
            Explorar desafios
        </a>

    </section>

</main>