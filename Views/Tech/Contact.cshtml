@{
    ViewData["Title"] = "Contato";
}

<main class="contact-page">

    <!-- =========================================
         APRESENTAÇÃO
    ========================================== -->

    <section class="contact-profile">

        <div class="profile-image-container">

            <img src="~/img/pfp.jpg"
                 alt="Foto de perfil de Michel"
                 class="profile-image" />

        </div>


        <div class="profile-info">

            <span class="contact-label">
                DESENVOLVEDOR DO TECHCHALLENGE
            </span>

            <h1>
                Olá, eu sou <span>Michel.</span>
            </h1>

            <p class="profile-description">
                Sou programador e desenvolvedor responsável pela criação
                do TechChallenge. Gosto de transformar ideias em soluções
                digitais e explorar novas possibilidades através da
                tecnologia.
            </p>

            <p class="profile-description">
                O TechChallenge nasceu como uma forma de unir tecnologia,
                educação e colaboração em uma única plataforma.
            </p>

            <div class="profile-divider"></div>

            <span class="profile-message">
                Quer conhecer mais do meu trabalho?
                Encontre-me nas redes abaixo.
            </span>

        </div>

    </section>


    <!-- =========================================
         REDES SOCIAIS
    ========================================== -->

    <section class="contact-social">

        <div class="contact-section-title">

            <span>
                CONECTE-SE COMIGO
            </span>

            <h2>
                Onde me encontrar.
            </h2>

            <p>
                Acompanhe meus projetos, trabalhos e conteúdos
                através das minhas redes.
            </p>

        </div>


        <div class="social-grid">


            <!-- =================================
                 GITHUB
            ================================== -->

            <article class="social-card">

                <div class="social-logo github-logo">
                    <i class="bi bi-github" aria-hidden="true"></i>
                </div>

                <h3>GitHub</h3>

                <a href="https://github.com/MichelAcre"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="social-button">

                    <i class="bi bi-github" aria-hidden="true"></i>

                    github.com/MichelAcre

                </a>

            </article>


            <!-- =================================
                 INSTAGRAM
            ================================== -->

            <article class="social-card">

                <div class="social-logo instagram-logo">
                    <i class="bi bi-instagram" aria-hidden="true"></i>
                </div>

                <h3>Instagram</h3>

                <a href="https://www.instagram.com/mich_z5/"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="social-button">

                    <i class="bi bi-instagram" aria-hidden="true"></i>

                    @@mich_z5

                </a>

            </article>


            <!-- =================================
                 YOUTUBE
            ================================== -->

            <article class="social-card">

                <div class="social-logo youtube-logo">
                    <i class="bi bi-youtube" aria-hidden="true"></i>
                </div>

                <h3>YouTube</h3>

                <a href="https://www.youtube.com/@@biel_365"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="social-button">

                    <i class="bi bi-youtube" aria-hidden="true"></i>

                    @@Michel_Z5

                </a>

            </article>


            <!-- =================================
                 X
            ================================== -->

            <article class="social-card">

                <div class="social-logo x-logo">
                    <i class="bi bi-twitter-x" aria-hidden="true"></i>
                </div>

                <h3>X</h3>

                <a href="https://www.youtube.com/watch?v=dQw4w9WgXcQ"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="social-button">

                    <i class="bi bi-twitter-x" aria-hidden="true"></i>

                    @@mich

                </a>

            </article>


            <!-- =================================
                 DISCORD
            ================================== -->

            <article class="social-card">

                <div class="social-logo discord-logo">
                    <i class="bi bi-discord" aria-hidden="true"></i>
                </div>

                <h3>Discord</h3>

                <a href="https://discord.gg/nnvoucriarumservidorprosite"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="social-button">

                    <i class="bi bi-discord" aria-hidden="true"></i>

                    TechChallenge - Servidor

                </a>

            </article>


        </div>

    </section>


    <!-- =========================================
         MENSAGEM FINAL
    ========================================== -->

    <section class="contact-footer">

        <div>

            <span>
                TECHCHALLENGE
            </span>

            <h2>
                Vamos criar algo interessante.
            </h2>

            <p>
                Tecnologia começa com uma ideia.
                O próximo passo é colocá-la em prática.
            </p>

        </div>

    </section>

</main>