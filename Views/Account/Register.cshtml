@model TechChallenge.RegisterViewModel

@{
    ViewData["Title"] = "Cadastro";
}

<div class="container d-flex align-items-center justify-content-center mt-5 text-center">
    <div class="card register-card card-dark text-light">
        <h2>Criar conta</h2>
        <p class="lead textSecondary">Registre uma conta para ter acesso a todas as funcionalidades</p>
        <div class="card-body">
            <form asp-action="Register" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger">
                </div>
                <div class="row mb-1">
                    <div class="text-start col-6">
                        <label asp-for="Nome" class="form-label">Nome</label>
                        <div class="input-group mb-3">
                            <span class="input-group-text">
                                <i class="bi bi-person ourple"></i>
                            </span>

                            <input asp-for="Nome" class="form-control" placeholder="Digite seu nome">
                        </div>
                        <span asp-validation-for="Nome" class="text-danger"></span>
                    </div>

                    <div class="text-start col-6">
                        <label asp-for="Email" class="form-label">Email</label>
                        <div class="input-group mb-3">
                            <span class="input-group-text">
                                <i class="bi bi-envelope ourple"></i>
                            </span>

                            <input asp-for="Email" class="form-control" placeholder="example@email.com">
                        </div>
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-1">
                    <div class="text-start col-6">
                        <label asp-for="Senha" class="form-label">Senha</label>
                        <div class="input-group mb-3">
                            <span class="input-group-text">
                                <i class="bi bi-lock ourple"></i>
                            </span>

                            <input asp-for="Senha" class="form-control" type="password" placeholder="Digite sua senha">
                        </div>
                        <span asp-validation-for="Senha" class="text-danger"></span>
                    </div>

                    <div class="text-start col-6">
                        <label asp-for="ConfirmarSenha" class="form-label">Confirmar Senha
                        </label>
                        <input asp-for="ConfirmarSenha" type="password" class="form-control"
                               placeholder="Confirme sua senha" />
                        <span asp-validation-for="ConfirmarSenha" class="text-danger">
                        </span>
                    </div>
                </div>
                <div class="mb-3">
                    <label asp-for="Role" class="form-label">
                    </label>
                    <select asp-for="Role" class="form-select">
                        <option value="">
                            Selecione o tipo de usuário
                        </option>
                        <option value="Aluno">
                            Aluno
                        </option>
                        <option value="Professor">
                            Professor
                        </option>
                    </select>

                    <span asp-validation-for="Role" class="text-danger">
                    </span>
                </div>

                <button type="submit" class="btn btn-ourple w-100">
                    Cadastrar
                </button>
            </form>
        </div>
        <div class="card-footer text-center">
            Já possui conta?
            <a asp-controller="Account" asp-action="Login" class="text-decoration-none ourple">Entrar</a>
            </div>
        </div>
    </div>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }