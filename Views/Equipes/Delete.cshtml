@model TechChallenge.Models.Equipe

@{
    ViewData["Title"] = "Excluir Equipe";
}

<div class="delete-page">

    <div class="delete-card">

        <div class="delete-header">

            <div class="delete-icon">
                <i class="bi bi-trash-fill"></i>
            </div>

            <h1 class="delete-title">
                Excluir Equipe
            </h1>

            <p class="delete-warning">
                Tem certeza de que deseja excluir esta equipe?
                Esta ação não poderá ser desfeita.
            </p>

        </div>


        <div class="delete-info">

            <div class="delete-info-row">
                <span>Nome</span>
                <strong>@Html.DisplayFor(model => model.Nome)</strong>
            </div>

            <div class="delete-info-row">
                <span>Descrição</span>
                <strong>@Html.DisplayFor(model => model.Descricao)</strong>
            </div>

            <div class="delete-info-row">
                <span>Data de criação</span>
                <strong>@Html.DisplayFor(model => model.DataCriacao)</strong>
            </div>

            <div class="delete-info-row">
                <span>Status</span>
                <strong>
                    @(Model.Ativa ? "Ativa" : "Inativa")
                </strong>
            </div>

        </div>


        <form asp-action="Delete" class="delete-actions">

            <input type="hidden" asp-for="Id" />

            <a asp-action="Index"
               class="delete-cancel">

                <i class="bi bi-arrow-left"></i>
                Cancelar

            </a>

            <button type="submit"
                    class="delete-confirm">

                <i class="bi bi-trash-fill"></i>
                Excluir equipe

            </button>

        </form>

    </div>

</div>