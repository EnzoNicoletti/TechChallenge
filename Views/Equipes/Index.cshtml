@model IEnumerable<TechChallenge.Models.Equipe>

@{
    ViewData["Title"] = "Equipes";
}

<div class="table-page">

    <!-- Cabeçalho -->
    <div class="table-page-header">

        <div>
            <h1 class="table-page-title">
                Equipes
            </h1>

            <p class="table-page-description">
                Organize e acompanhe as equipes responsáveis pelo desenvolvimento
                dos projetos estudantis dentro da plataforma.
            </p>
        </div>

        <a asp-action="Create" class="table-create-button">
            <i class="bi bi-plus-lg"></i>
            Nova Equipe
        </a>

    </div>


    <!-- Tabela -->
    <div class="table-container">

        <div class="table-responsive">

            <table class="table tech-table table-striped">

                <thead>
                    <tr>

                        <th>
                            @Html.DisplayNameFor(model => model.Nome)
                        </th>

                        <th>
                            @Html.DisplayNameFor(model => model.Descricao)
                        </th>

                        <th>
                            @Html.DisplayNameFor(model => model.DataCriacao)
                        </th>

                        <th>
                            @Html.DisplayNameFor(model => model.Ativa)
                        </th>

                        <th class="actions-column">
                            Ações
                        </th>

                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <!-- NOME -->
                            <td class="fw-semibold">
                                @Html.DisplayFor(modelItem => item.Nome)
                            </td>


                            <!-- DESCRIÇÃO -->
                            <td>
                                @Html.DisplayFor(modelItem => item.Descricao)
                            </td>


                            <!-- DATA -->
                            <td>
                                @Html.DisplayFor(modelItem => item.DataCriacao)
                            </td>


                            <!-- STATUS -->
                            <td>

                                @if (item.Ativa)
                                {
                                    <span class="badge category-active">
                                        <i class="bi bi-check-circle-fill"></i>
                                        Ativa
                                    </span>
                                }
                                else
                                {
                                    <span class="badge category-inactive">
                                        <i class="bi bi-dash-circle-fill"></i>
                                        Inativa
                                    </span>
                                }

                            </td>


                            <!-- AÇÕES -->
                            <td>

                                <div class="table-actions">

                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="table-action edit-action"
                                       title="Editar">

                                        <i class="bi bi-pencil-fill"></i>

                                    </a>


                                    <a asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="table-action details-action"
                                       title="Detalhes">

                                        <i class="bi bi-eye-fill"></i>

                                    </a>


                                    <a asp-action="Delete"
                                       asp-route-id="@item.Id"
                                       class="table-action delete-action"
                                       title="Excluir">

                                        <i class="bi bi-trash-fill"></i>

                                    </a>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>