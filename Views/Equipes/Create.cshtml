@model TechChallenge.Models.Equipe

@{
    ViewData["Title"] = "Nova Equipe";
}

<div class="create-page">

    <div class="create-header">
        <h1 class="create-title">Nova Equipe</h1>
        <p class="create-subtitle">
            Cadastre uma equipe para organizar os estudantes envolvidos
            no desenvolvimento dos projetos.
        </p>
    </div>

    <div class="create-form-card">

        <form asp-action="Create">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger create-validation"></div>

            <div class="create-form-group">
                <label asp-for="Nome"></label>
                <input asp-for="Nome" class="form-control" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>

            <div class="create-form-group">
                <label asp-for="Descricao"></label>
                <input asp-for="Descricao" class="form-control" />
                <span asp-validation-for="Descricao" class="text-danger"></span>
            </div>

            <div class="create-form-group">
                <label asp-for="DataCriacao"></label>
                <input asp-for="DataCriacao" class="form-control" />
                <span asp-validation-for="DataCriacao" class="text-danger"></span>
            </div>

            <div class="create-form-check">
                <input class="form-check-input" asp-for="Ativa" />
                <label asp-for="Ativa"></label>
            </div>

            <div class="create-form-actions">

                <a asp-action="Index" class="create-back">
                    <i class="bi bi-arrow-left"></i>
                    Voltar para equipes
                </a>

                <button type="submit" class="btn btn-primary create-submit">
                    <i class="bi bi-people-fill"></i>
                    Criar equipe
                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}