@model TechChallenge.Models.Equipe

@{
    ViewData["Title"] = "Detalhes da Equipe";
}

<div class="form-page">

    <div class="form-page-header">
        <h1 class="form-page-title">Detalhes da Equipe</h1>
        <p class="form-page-description">
            Consulte as informações da equipe responsável pela participação nos projetos escolares.
        </p>
    </div>

    <div class="details-card">

        <h4 class="details-title">Equipe</h4>

        <dl class="details-list">

            <dt>@Html.DisplayNameFor(model => model.Nome)</dt>
            <dd>@Html.DisplayFor(model => model.Nome)</dd>

            <dt>@Html.DisplayNameFor(model => model.Descricao)</dt>
            <dd>@Html.DisplayFor(model => model.Descricao)</dd>

            <dt>@Html.DisplayNameFor(model => model.DataCriacao)</dt>
            <dd>@Html.DisplayFor(model => model.DataCriacao)</dd>

            <dt>@Html.DisplayNameFor(model => model.Ativa)</dt>
            <dd>
                @if (Model.Ativa)
                {
                    <span class="badge bg-success">Ativa</span>
                }
                else
                {
                    <span class="badge bg-secondary">Inativa</span>
                }
            </dd>

        </dl>

        <div class="details-actions">

            <a asp-action="Edit"
               asp-route-id="@Model?.Id"
               class="btn btn-primary">
                <i class="bi bi-pencil-fill"></i>
                Editar
            </a>

            <a asp-action="Index"
               class="details-back-link">
                Voltar para a lista
            </a>

        </div>

    </div>

</div>