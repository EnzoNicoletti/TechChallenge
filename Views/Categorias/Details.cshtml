@model TechChallenge.Categoria

@{
    ViewData["Title"] = "Detalhes da Categoria";
}

<div class="form-page">

    <div class="form-page-header">
        <h1 class="form-page-title">Detalhes da Categoria</h1>
        <p class="form-page-description">
            Consulte as informações da categoria utilizada para organizar os projetos escolares.
        </p>
    </div>

    <div class="details-card">

        <h4 class="details-title">Categoria</h4>

        <dl class="details-list">

            <dt>@Html.DisplayNameFor(model => model.Nome)</dt>
            <dd>@Html.DisplayFor(model => model.Nome)</dd>

            <dt>@Html.DisplayNameFor(model => model.Descricao)</dt>
            <dd>@Html.DisplayFor(model => model.Descricao)</dd>

            <dt>@Html.DisplayNameFor(model => model.Cor)</dt>
            <dd>
                <span class="category-color-preview"
                      style="background-color:@Model.Cor;">
                </span>

                @Model.Cor
            </dd>

            <dt>@Html.DisplayNameFor(model => model.Ativa)</dt>
            <dd>
                @if (Model.Ativa)
                {
                    <span class="badge bg-success">Ativa</span>
                }
                else
                {
                    <span class="badge bg-secondary">Inativa</span>
                }
            </dd>

            <dt>@Html.DisplayNameFor(model => model.DataCadastro)</dt>
            <dd>@Html.DisplayFor(model => model.DataCadastro)</dd>

        </dl>

        <div class="details-actions">

            <a asp-action="Edit"
               asp-route-id="@Model?.Id"
               class="btn btn-primary">
                <i class="bi bi-pencil-fill"></i>
                Editar
            </a>

            <a asp-action="Index"
               class="details-back-link">
                Voltar para a lista
            </a>

        </div>

    </div>

</div>