@model TechChallenge.Categoria

@{
    ViewData["Title"] = "Nova Categoria";
}

<div class="create-page">

    <div class="create-header">
        <h1 class="create-title">Nova Categoria</h1>
        <p class="create-subtitle">
            Crie uma categoria para organizar e identificar diferentes tipos de projetos.
        </p>
    </div>

    <div class="create-form-card">

        <form asp-action="Create">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger create-validation"></div>

            <div class="create-form-group">
                <label asp-for="Nome"></label>
                <input asp-for="Nome" class="form-control" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>

            <div class="create-form-group">
                <label asp-for="Descricao"></label>
                <input asp-for="Descricao" class="form-control" />
                <span asp-validation-for="Descricao" class="text-danger"></span>
            </div>

            <div class="create-form-group">
                <label asp-for="Cor"></label>
                <input type="color"
                       asp-for="Cor"
                       class="form-control create-color-input" />
                <span asp-validation-for="Cor" class="text-danger"></span>
            </div>

            <div class="create-form-check">
                <input class="form-check-input" asp-for="Ativa" />
                <label asp-for="Ativa"></label>
            </div>

            <div class="create-form-group">
                <label asp-for="DataCadastro"></label>
                <input asp-for="DataCadastro" class="form-control" />
                <span asp-validation-for="DataCadastro" class="text-danger"></span>
            </div>

            <div class="create-form-actions">

                <a asp-action="Index" class="create-back">
                    <i class="bi bi-arrow-left"></i>
                    Voltar para categorias
                </a>

                <button type="submit" class="btn btn-primary create-submit">
                    <i class="bi bi-plus-circle-fill"></i>
                    Criar categoria
                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}