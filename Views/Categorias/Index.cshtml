@model IEnumerable<TechChallenge.Categoria>

@{
    ViewData["Title"] = "Categorias";
}

<div class="table-page">

    <!-- Cabeçalho da página -->
    <div class="table-page-header">

        <div>
            <h1 class="table-page-title">
                Categorias
            </h1>

            <p class="table-page-description">
                Gerencie as categorias utilizadas para organizar e identificar
                os projetos estudantis da plataforma.
            </p>
        </div>

        <a asp-action="Create" class="table-create-button">
            <i class="bi bi-plus-lg"></i>
            Nova Categoria
        </a>

    </div>


    <!-- Tabela -->
    <div class="table-container">

        <div class="table-responsive">

            <table class="table tech-table table-striped">

                <thead>
                    <tr>

                        <th>
                            @Html.DisplayNameFor(model => model.Nome)
                        </th>

                        <th>
                            @Html.DisplayNameFor(model => model.Descricao)
                        </th>

                        <th>
                            @Html.DisplayNameFor(model => model.Cor)
                        </th>

                        <th>
                            @Html.DisplayNameFor(model => model.Ativa)
                        </th>

                        <th>
                            @Html.DisplayNameFor(model => model.DataCadastro)
                        </th>

                        <th class="actions-column">
                            Ações
                        </th>

                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td class="fw-semibold">
                                @Html.DisplayFor(modelItem => item.Nome)
                            </td>


                            <td>
                                @Html.DisplayFor(modelItem => item.Descricao)
                            </td>


                            <!-- COR -->
                            <td>

                                <div class="category-color">

                                    <span class="category-color-preview"
                                          style="background-color: @item.Cor;">
                                    </span>

                                    <span class="category-color-code"
                                          style="color: @item.Cor;">
                                        @item.Cor
                                    </span>

                                </div>

                            </td>


                            <!-- STATUS -->
                            <td>

                                @if (item.Ativa)
                                {
                                    <span class="badge category-active">
                                        <i class="bi bi-check-circle-fill"></i>
                                        Ativo
                                    </span>
                                }
                                else
                                {
                                    <span class="badge category-inactive">
                                        <i class="bi bi-dash-circle-fill"></i>
                                        Inativo
                                    </span>
                                }

                            </td>


                            <!-- DATA -->
                            <td>
                                @Html.DisplayFor(modelItem => item.DataCadastro)
                            </td>


                            <!-- AÇÕES -->
                            <td>

                                <div class="table-actions">

                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="table-action edit-action"
                                       title="Editar">

                                        <i class="bi bi-pencil-fill"></i>

                                    </a>


                                    <a asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="table-action details-action"
                                       title="Detalhes">

                                        <i class="bi bi-eye-fill"></i>

                                    </a>


                                    <a asp-action="Delete"
                                       asp-route-id="@item.Id"
                                       class="table-action delete-action"
                                       title="Excluir">

                                        <i class="bi bi-trash-fill"></i>

                                    </a>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>